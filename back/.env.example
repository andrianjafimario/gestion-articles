# Backend environment variables
# Copy this file to `back/.env` and adjust values for your environment.

# Runtime mode: `development`, `test`, `production`
NODE_ENV=development

# API port (default in code: 5000)
PORT=5000

# Prisma database URL (SQLite local file by default)
# Example PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/trm_db?schema=public"
DATABASE_URL="file:./dev.db"

# Public URL used in notification links sent by email
# Keep this aligned with your deployed backend domain in production.
APP_URL="http://localhost:5000"

# JWT secret used to sign auth tokens
# Required in production: use a long random value.
JWT_SECRET="change-me-in-production"

# Sender address displayed in outgoing emails
EMAIL_FROM="noreply@cms.local"

# SMTP configuration (required in production when NODE_ENV=production)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
